{
    "name": "checkoutcom-storefront-next",
    "version": "26.5.0",
    "private": true,
    "description": "Checkout.com Flow payments for Salesforce B2C Commerce Storefront Next",
    "license": "UNLICENSED",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "test": "node --test test/cartridge/*.test.js",
        "check:syntax": "find cartridges -name '*.js' -not -path '*/static/*' -exec node --check {} +",
        "validate:impex": "node scripts/validate-impex.mjs",
        "impex": "node scripts/prepare-impex.mjs",
        "deploy:cartridges": "b2c code deploy cartridges -r",
        "verify": "npm run check:syntax && npm test && npm run validate:impex"
    }
}
