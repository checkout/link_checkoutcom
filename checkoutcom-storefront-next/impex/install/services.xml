    <!-- Credentials carry no user-id or password: the secret key is read from the
         site preferences at runtime, so re-importing never blanks anything. -->
    <service-credential service-credential-id="cko.flow.sessions.sandbox.credential">
        <url>https://api.sandbox.checkout.com/payment-sessions</url>
    </service-credential>

