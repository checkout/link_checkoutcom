<li class="nav-item" data-method-id="${paymentOption.ID}">
    <a class="nav-link alipayhk-tab" data-toggle="tab" href="#alipayhk-content" role="tab">
        <isif condition="${dw.order.PaymentMgr.getPaymentMethod(paymentOption.ID).image != null}">
            <img alt="${paymentOption.name}" height="22" id="alipayhk_thumb" src="${dw.order.PaymentMgr.getPaymentMethod(paymentOption.ID).image.URL}"/>
        </isif>
        <img alt="Alipay+" height="22" id="alipayplus_logo" src="${URLUtils.staticURL('/images/thumbs/alipayplus.png')}"/>
        ${paymentOption.name}
    </a>
</li>
