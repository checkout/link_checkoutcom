<div class="tab-pane alipaycn-content" id="alipaycn-content" role="tabpanel">
    <fieldset class="payment-form-fields">
        <div class="invalid-field-message"></div>
        <p class="alipaycn-redirect-message">${Resource.msg('cko.alipaycn.redirect.message','cko',null)}</p>
        <input type="hidden" class="form-control" name="${pdict.forms.billingForm.paymentMethod.htmlName}" value="CHECKOUTCOM_ALIPAYCN" />
        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
    </fieldset>
</div>
