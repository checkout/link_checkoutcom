<iscomment>
    Checkout.com Flow billing tab.

    Flow collects the payment details itself, on the CKOFlow-Show page that the
    shopper is taken to after placing the order, so this tab only carries the
    payment method selection.
</iscomment>
<div class="tab-pane flow-content" id="flow-content" role="tabpanel">
    <fieldset class="payment-form-fields">
        <input type="hidden" class="form-control" name="${pdict.forms.billingForm.paymentMethod.htmlName}" value="" />
        <input type="hidden" name="${pdict.csrf.tokenName}" value="${pdict.csrf.token}" />
        <div class="flow-info">
            <p class="flow-info-message">${Resource.msg('cko.flow.info','cko',null)}</p>
        </div>
    </fieldset>
</div>
