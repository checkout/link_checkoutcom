<isset name="billingFields" value="${pdict.forms.billingForm.addressFields}" scope="page"/>
<div class="row">
    <div class="col-sm-6">
        <div class="form-group
            ${billingFields.firstName.mandatory === true ? 'required' : ''}
            ${billingFields.firstName.htmlName}">
            <label class="form-control-label" for="billingFirstName">${Resource.msg('field.billing.address.first.name','address',null)}</label>
            <input autofocus type="text" class="form-control billingFirstName" id="billingFirstName"
                value="${pdict.order.billing.billingAddress.address
                    && pdict.order.billing.billingAddress.address.firstName
                    ? pdict.order.billing.billingAddress.address.firstName
                    : ''}"
                name="${billingFields.firstName.htmlName}"
                <isif condition="${billingFields.firstName.mandatory === true}">required aria-required="true"</isif>
                <isif condition="${!empty(billingFields.firstName.maxLength)}">maxLength="${billingFields.firstName.maxLength}"</isif>
                <isif condition="${!empty(billingFields.firstName.minLength)}">minLength="${billingFields.firstName.minLength}"</isif>
                <isif condition="${!empty(billingFields.firstName.regEx)}">pattern="${billingFields.firstName.regEx}"</isif>
                autocomplete="given-name" >
            <div class="invalid-feedback"></div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group
            ${billingFields.lastName.mandatory === true ? 'required' : ''}
            ${billingFields.lastName.htmlName}">
            <label class="form-control-label" for="billingLastName">${Resource.msg('field.billing.address.last.name','address',null)}</label>
            <input type="text" class="form-control billingLastName" id="billingLastName"
                value="${pdict.order.billing.billingAddress.address
                    && pdict.order.billing.billingAddress.address.lastName
                    ? pdict.order.billing.billingAddress.address.lastName
                    : ''}"
                name="${billingFields.lastName.htmlName}"
                <isif condition="${billingFields.lastName.mandatory === true}">required aria-required="true"</isif>
                <isif condition="${!empty(billingFields.lastName.maxLength)}">maxLength="${billingFields.lastName.maxLength}"</isif>
                <isif condition="${!empty(billingFields.lastName.minLength)}">minLength="${billingFields.lastName.minLength}"</isif>
                <isif condition="${!empty(billingFields.lastName.regEx)}">pattern="${billingFields.lastName.regEx}"</isif>
                autocomplete="family-name">
            <div class="invalid-feedback"></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group
            ${billingFields.address1.mandatory === true ? 'required' : ''}
            ${billingFields.address1.htmlName}">
            <label class="form-control-label" for="billingAddressOne">${Resource.msg('field.billing.address.one','address',null)}</label>
            <input type="text" class="form-control billingAddressOne" id="billingAddressOne"
                value="${pdict.order.billing.billingAddress.address
                    && pdict.order.billing.billingAddress.address.address1
                    ? pdict.order.billing.billingAddress.address.address1
                    : ''}"
                name="${billingFields.address1.htmlName}"
                <isif condition="${billingFields.address1.mandatory === true}">required aria-required="true"</isif>
                <isif condition="${!empty(billingFields.address1.maxLength)}">maxLength="${billingFields.address1.maxLength}"</isif>
                <isif condition="${!empty(billingFields.address1.minLength)}">minLength="${billingFields.address1.minLength}"</isif>
                <isif condition="${!empty(billingFields.address1.regEx)}">pattern="${billingFields.address1.regEx}"</isif>
                autocomplete="billing address-line1">
            <div class="invalid-feedback"></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-12">
        <div class="form-group
            ${billingFields.address2.mandatory === true ? 'required' : ''}
            ${billingFields.address2.htmlName}">
            <label class="form-control-label" for="billingAddressTwo">${Resource.msg('field.billing.address.two','address',null)}</label>
            <input type="text" class="form-control billingAddressTwo" id="billingAddressTwo"
                value="${pdict.order.billing.billingAddress.address
                    && pdict.order.billing.billingAddress.address.address2
                    ? pdict.order.billing.billingAddress.address.address2
                    : ''}"
                name="${billingFields.address2.htmlName}"
                <isif condition="${billingFields.address2.mandatory === true}">required aria-required="true"</isif>
                <isif condition="${!empty(billingFields.address2.maxLength)}">maxLength="${billingFields.address2.maxLength}"</isif>
                <isif condition="${!empty(billingFields.address2.minLength)}">minLength="${billingFields.address2.minLength}"</isif>
                <isif condition="${!empty(billingFields.address2.regEx)}">pattern="${billingFields.address2.regEx}"</isif>
                autocomplete="billing address-line2">
            <div class="invalid-feedback"></div>
        </div>
    </div>
</div>

<!--- make drop down--->
<div class="row">
    <div class="col-sm-6">
        <div class="form-group
            ${billingFields.country.mandatory === true ? 'required' : ''}
            ${billingFields.country.htmlName}">
            <label class="form-control-label" for="billingCountry">${Resource.msg('field.billing.address.country','address',null)}</label>
            <select class="form-control billingCountry custom-select" id="billingCountry"
                name="${billingFields.country.htmlName}"
                <isif condition="${billingFields.country.mandatory === true}">required aria-required="true"</isif>
                autocomplete="billing country">
                    <option label=" "></option>
                    <isloop items=${billingFields.country.options} var="country">
                        <option id="${country.id}" value="${country.htmlValue}"
                            ${pdict.order.billing.billingAddress.address
                                && country.id === pdict.order.billing.billingAddress.address.countryCode.value
                                ? "selected"
                                : "" }
                        >
                            ${country.label}
                        </option>
                    </isloop>
            </select>
            <div class="invalid-feedback"></div>

        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group
            ${billingFields.states.stateCode.mandatory === true ? 'required' : ''}
            ${billingFields.states.stateCode.htmlName}">
            <label class="form-control-label" for="billingState">${Resource.msg('field.billing.address.state','address',null)}</label>
            <select class="form-control billingState custom-select" id="billingState"
                name="${billingFields.states.stateCode.htmlName}"
                <isif condition="${billingFields.states.stateCode.mandatory === true}">required aria-required="true"</isif>
                autocomplete="billing address-level1">
                    <isloop items=${billingFields.states.stateCode.options} var="state">
                        <option id="${state.id}"  value="${state.htmlValue}"
                            ${pdict.order.billing.billingAddress.address
                                && state.id === pdict.order.billing.billingAddress.address.stateCode
                                ? "selected"
                                : "" }
                        >
                            ${state.label}
                        </option>
                    </isloop>
            </select>
            <div class="invalid-feedback"></div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-sm-6">
        <div class="form-group
            ${billingFields.city.mandatory === true ? 'required' : ''}
            ${billingFields.city.htmlName}">
            <label class="form-control-label" for="billingAddressCity">${Resource.msg('field.billing.address.city','address',null)}</label>
            <input type="text" class="form-control billingAddressCity" id="billingAddressCity"
                value="${pdict.order.billing.billingAddress.address
                    && pdict.order.billing.billingAddress.address.city
                    ? pdict.order.billing.billingAddress.address.city
                    : ''}"
                name="${billingFields.city.htmlName}"
                <isif condition="${billingFields.city.mandatory === true}">required aria-required="true"</isif>
                <isif condition="${!empty(billingFields.city.maxLength)}">maxLength="${billingFields.city.maxLength}"</isif>
                <isif condition="${!empty(billingFields.city.minLength)}">minLength="${billingFields.city.minLength}"</isif>
                <isif condition="${!empty(billingFields.city.regEx)}">pattern="${billingFields.city.regEx}"</isif>
                autocomplete="billing address-level2">
            <div class="invalid-feedback"></div>
        </div>
    </div>
    <div class="col-sm-6">
        <div class="form-group
            ${billingFields.postalCode.mandatory === true ? 'required' : ''}
            ${billingFields.postalCode.htmlName}">
            <label class="form-control-label" for="billingZipCode">${Resource.msg('field.billing.address.zip.code','address',null)}</label>
            <input type="text" class="form-control billingZipCode" id="billingZipCode"
                value="${pdict.order.billing.billingAddress.address
                    && pdict.order.billing.billingAddress.address.postalCode
                    ? pdict.order.billing.billingAddress.address.postalCode
                    : ''}"
                name="${billingFields.postalCode.htmlName}"
                <isif condition="${billingFields.postalCode.mandatory === true}">required aria-required="true"</isif>
                <isif condition="${!empty(billingFields.postalCode.maxLength)}">maxLength="${billingFields.postalCode.maxLength}"</isif>
                <isif condition="${!empty(billingFields.postalCode.minLength)}">minLength="${billingFields.postalCode.minLength}"</isif>
                <isif condition="${!empty(billingFields.postalCode.regEx)}">pattern="${billingFields.postalCode.regEx}"</isif>
                autocomplete="billing postal-code">
            <div class="invalid-feedback"></div>
            <span>${Resource.msg('example.postalcode','forms',null)}</span>
        </div>
    </div>
</div>
